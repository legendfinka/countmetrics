# Shared by api and worker
NODE_ENV=development
DATABASE_URL=postgresql://countmetrics:countmetrics@localhost:5432/countmetrics
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Ingestion rate limits (requests per minute)
RATE_LIMIT_IP_PER_MIN=600
RATE_LIMIT_SITE_PER_MIN=60000
# Proxies in front of the API (0 locally, usually 1 on Render or Railway)
TRUST_PROXY_HOPS=0

# Only for tests. Must be different from the dev ones. Tests delete data.
DATABASE_URL_TEST=postgresql://countmetrics:countmetrics@localhost:5432/countmetrics_test
REDIS_URL_TEST=redis://localhost:6379/15

# Worker
WORKER_BATCH_SIZE=500
WORKER_FLUSH_INTERVAL_MS=1000
WORKER_CONCURRENCY=200
