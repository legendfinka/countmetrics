# Shared by api and worker
NODE_ENV=development
DATABASE_URL=postgresql://countmetrics:countmetrics@localhost:5432/countmetrics
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Tests only. Must be a different database: tests wipe tables.
DATABASE_URL_TEST=postgresql://countmetrics:countmetrics@localhost:5432/countmetrics_test

# Worker
WORKER_BATCH_SIZE=500
WORKER_FLUSH_INTERVAL_MS=1000
