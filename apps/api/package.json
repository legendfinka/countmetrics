{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prisma": "dotenv -e ../../.env -- prisma",
    "seed": "tsx --env-file=../../.env prisma/seed.ts"
  },
  "dependencies": {
    "@countmetrics/shared": "workspace:*",
    "@prisma/client": "^6.0.0",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv-cli": "^7.4.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
