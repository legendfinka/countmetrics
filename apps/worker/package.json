{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import tsx src/index.ts",
    "queue-depth": "tsx --env-file=../../.env src/queue-depth.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "dotenv -e ../../.env -- vitest run --passWithNoTests"
  },
  "dependencies": {
    "@countmetrics/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^7.4.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
